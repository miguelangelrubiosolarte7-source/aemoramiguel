# ==============================================================================
# AEMORA BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Application
PROJECT_NAME="Aemora Enterprise API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Cryptography & JWT Security (OWASP API2)
# Generate a strong key in production using: openssl rand -hex 32
SECRET_KEY="replace_this_with_a_super_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with psycopg3 async driver)
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/aemora_db"

# Firebase Admin SDK (server-side verification of Google/Facebook ID tokens)
FIREBASE_PROJECT_ID="your-firebase-project-id"
# Prefer a secret manager in production. For local development, paste the service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Or provide an absolute path outside the repository:
FIREBASE_SERVICE_ACCOUNT_FILE=""

# Groq Cloud AI Engine (OWASP API10)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# CORS Security (Allowed Origins)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Rate Limiting (SlowAPI)
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="3/minute"
RATE_LIMIT_AI="10/minute"
RATE_LIMIT_POSTS="30/minute"
